<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background"
    android:padding="24dp">

    <!-- Soft, oversized category emoji watermark for quick visual identity —
         "which kind of alarm is this" should read before you even read the text. -->
    <TextView
        android:id="@+id/categoryWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0.35"
        android:textSize="34sp"
        android:text="📚"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_on_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/categoryWatermark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/missionInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_on_dark"
        android:alpha="0.8"
        android:text="@string/dismiss_alarm"
        app:layout_constraintTop_toBottomOf="@id/alarmTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MATH mission views -->
    <TextView
        android:id="@+id/mathProblem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_on_dark"
        android:textSize="44sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/missionInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="56dp" />

    <EditText
        android:id="@+id/mathAnswer"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:inputType="numberSigned"
        android:textColor="@color/text_on_dark"
        android:textColorHint="#80FFFFFF"
        android:textSize="20sp"
        android:gravity="center"
        android:background="@null"
        android:hint="?"
        app:layout_constraintTop_toBottomOf="@id/mathProblem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="22dp" />

    <View
        android:id="@+id/mathAnswerRule"
        android:layout_width="160dp"
        android:layout_height="2dp"
        android:background="#66FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/mathAnswer"
        app:layout_constraintStart_toStartOf="@id/mathAnswer"
        app:layout_constraintEnd_toEndOf="@id/mathAnswer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mathSubmit"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/submit"
        android:textColor="@color/alarm_background"
        app:backgroundTint="@color/text_on_dark"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/mathAnswerRule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="26dp" />

    <!-- SHAKE mission views -->
    <TextView
        android:id="@+id/shakeProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_on_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/missionInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/shakeBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        app:trackThickness="10dp"
        app:trackCornerRadius="6dp"
        app:indicatorColor="@color/text_on_dark"
        app:trackColor="#33FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/shakeProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- CAMERA mission views -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/missionInstruction"
        app:layout_constraintBottom_toTopOf="@id/cameraTimeRemaining"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/cameraActivityBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="100"
        app:trackThickness="8dp"
        app:trackCornerRadius="5dp"
        app:indicatorColor="@color/text_on_dark"
        app:trackColor="#33FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/cameraTimeRemaining"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <TextView
        android:id="@+id/cameraTimeRemaining"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_on_dark"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
