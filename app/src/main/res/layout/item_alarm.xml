<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Category icon badge replaces the old plain color dot — a soft
             tinted circle with an emoji glyph, resolved per-category in
             AlarmAdapter (bg_badge_* + the emoji for that category). -->
        <FrameLayout
            android:id="@+id/categoryBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_student"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/categoryEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:text="📚" />
        </FrameLayout>

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111318"
            app:layout_constraintTop_toTopOf="@id/categoryBadge"
            app:layout_constraintBottom_toBottomOf="@id/categoryBadge"
            app:layout_constraintStart_toEndOf="@id/categoryBadge"
            android:layout_marginStart="14dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1C22"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/categoryBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/enabledSwitch"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/missionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_pill_neutral"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/enabledSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/brand_primary"
            app:trackTint="@color/student_tint_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/editText"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_neutral"
            android:gravity="center"
            android:text="✏️"
            android:textSize="14sp"
            android:contentDescription="@string/edit_alarm"
            app:layout_constraintTop_toBottomOf="@id/enabledSwitch"
            app:layout_constraintEnd_toStartOf="@id/deleteText" />

        <TextView
            android:id="@+id/deleteText"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_neutral"
            android:gravity="center"
            android:text="🗑"
            android:textSize="14sp"
            android:contentDescription="@string/delete_alarm"
            app:layout_constraintTop_toBottomOf="@id/enabledSwitch"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
